# Compile only the Faiss CPU distance kernels and their link dependencies.
CXX_STD = CXX20
FAISS_SRC = .faiss/faiss-1.11.0
PKG_CPPFLAGS = -I$(FAISS_SRC) -DFINTEGER=int -DFAISS_STATIC
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = @FAISS_BLAS@ $(SHLIB_OPENMP_CXXFLAGS) $(FLIBS)

FAISS_OBJECTS = \
    $(FAISS_SRC)/faiss/impl/AuxIndexStructures.o \
    $(FAISS_SRC)/faiss/impl/FaissException.o \
    $(FAISS_SRC)/faiss/impl/IDSelector.o \
    $(FAISS_SRC)/faiss/utils/Heap.o \
    $(FAISS_SRC)/faiss/utils/distances.o \
    $(FAISS_SRC)/faiss/utils/distances_simd.o \
    $(FAISS_SRC)/faiss/utils/partitioning.o \
    $(FAISS_SRC)/faiss/utils/distances_fused/avx512.o \
    $(FAISS_SRC)/faiss/utils/distances_fused/distances_fused.o \
    $(FAISS_SRC)/faiss/utils/distances_fused/simdlib_based.o

OBJECTS = RcppExports.o emeans.o $(FAISS_OBJECTS)

all: $(SHLIB)

emeans.o $(FAISS_OBJECTS): .faiss/.prepared
